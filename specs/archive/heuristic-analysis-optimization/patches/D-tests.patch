+/// Per-kind availability for a sampled hand: four copies minus the missing
+/// suit and the player's own melds.
+fn availability(melds: &[Meld], missing: Suit) -> [u8; TILE_KINDS] {
+    let mut capacity = [COPIES_PER_TILE; TILE_KINDS];
+    for rank in 1..=9 {
+        capacity[tile(missing, rank).index() as usize] = 0;
+    }
+    for meld in melds {
+        let index = meld.tile().index() as usize;
+        capacity[index] = capacity[index].saturating_sub(meld.tile_count());
+    }
+    capacity
+}
+
+fn sample_hand(seed: u64, len: usize, availability: &[u8; TILE_KINDS]) -> Hand {
+    let mut state = seed.wrapping_mul(0x9E37_79B9_7F4A_7C15) | 1;
+    let mut sampled = Hand::new();
+    while sampled.total() < len {
+        state = state
+            .wrapping_mul(6_364_136_223_846_793_005)
+            .wrapping_add(1_442_695_040_888_963_407);
+        let draw = Tile::ALL[(state >> 33) as usize % TILE_KINDS];
+        if sampled.count(draw) >= availability[draw.index() as usize] {
+            continue;
+        }
+        sampled.add(draw).expect("capacity was checked");
+    }
+    sampled
+}
+
+#[test]
+fn sampled_hands_match_the_direct_win_shortcut() {
+    let missing = Suit::Tiao;
+    let meld_sets: [&[Meld]; 5] = [
+        &[],
+        &[Meld::peng(tile(Suit::Tong, 5), Seat::DEALER)],
+        &[
+            Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+            Meld::added_kong(tile(Suit::Tong, 6), Seat::DEALER),
+        ],
+        &[
+            Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+            Meld::open_kong(tile(Suit::Tong, 6), Seat::DEALER),
+            Meld::concealed_kong(tile(Suit::Tong, 7)),
+        ],
+        &[
+            Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+            Meld::open_kong(tile(Suit::Tong, 6), Seat::DEALER),
+            Meld::concealed_kong(tile(Suit::Tong, 7)),
+            Meld::added_kong(tile(Suit::Tong, 8), Seat::DEALER),
+        ],
+    ];
+
+    for (meld_count, melds) in meld_sets.into_iter().enumerate() {
+        let mut availability = availability(melds, missing);
+        let mut public = own_meld_public(melds);
+        // One visible discarded 9W leaves three copies for the sampled hand and
+        // exercises the unseen-copy subtraction without exhausting the kind.
+        let nine_wan = tile(Suit::Wan, 9);
+        availability[nine_wan.index() as usize] = 3;
+        add_public(&mut public, nine_wan, 1);
+
+        let len = 13 - 3 * meld_count;
+        for seed in 0..12u64 {
+            let sampled = sample_hand(seed + 1 + meld_count as u64 * 101, len, &availability);
+            assert_candidate_matches_original(
+                &format!("sampled m = {meld_count}"),
+                &sampled,
+                melds,
+                missing,
+                &public,
+            );
+        }
+    }
+}
