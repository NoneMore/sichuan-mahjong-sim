+#[test]
+fn higher_meld_counts_match_the_direct_win_shortcut() {
+    let missing = Suit::Tiao;
+
+    // m = 2: two pengs leave 1234567W, which waits on 7W.
+    let two = [
+        Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
