+#[test]
+fn hand_size_premise_is_required_for_zero_deficit_equivalence() {
+    // Outside the caller contract a hand larger than the target can reach
+    // deficit zero with surplus tiles while `rules::can_hu` rejects its size.
+    // This is why `ukeire` documents the `13 - 3m` tile premise: only then does
+    // `D(H + t) == 0` mean the same thing as `rules::can_hu(H + t)`.
+    let missing = Suit::Tiao;
+    let oversized = suit_hand(&[1, 2, 3, 4, 5, 6, 7, 8, 9], &[1, 1, 1, 9, 9], &[]);
+    assert_eq!(oversized.total(), 14);
+
+    let mut evaluator = DistanceEvaluator::new(&[], missing).expect("legal meld count");
+    assert_eq!(
+        evaluator.deficit(&oversized),
+        0,
+        "the 14-tile hand is itself a target"
+    );
+
+    let mut drawn = oversized;
+    drawn.add(tile(Suit::Tong, 9)).expect("fourth 9T is legal");
+    assert_eq!(drawn.total(), 15);
+    assert_eq!(
+        evaluator.deficit(&drawn),
+        0,
+        "surplus tiles keep the deficit at zero outside the size premise"
+    );
+    assert!(
+        !rules::can_hu(&drawn, &[], missing),
+        "can_hu rejects the 15-tile hand"
+    );
+}
+
+#[test]
+fn four_copy_premise_is_required_for_zero_deficit_equivalence() {
+    // Illegal state used only to pin the documented four-copy premise: a
+    // concealed kong owns all four 5T copies, so no legal hand can hold 5T
+    // again. Here `rules::can_hu` accepts the shape while the
+    // capacity-aware deficit cannot reach zero.
+    let missing = Suit::Tiao;
+    let kong = [Meld::concealed_kong(tile(Suit::Tong, 5))];
+    let concealed = suit_hand(&[1, 2, 3, 4, 5, 6, 7, 8, 9], &[5], &[]);
+    assert_eq!(concealed.total(), 10);
+
+    let mut evaluator = DistanceEvaluator::new(&kong, missing).expect("legal meld count");
+    assert_eq!(
+        evaluator.deficit(&concealed),
+        2,
+        "the pair must come from a W kind already used by a set"
+    );
+
+    let mut drawn = concealed;
+    drawn.add(tile(Suit::Tong, 5)).expect("second 5T");
+    assert!(
+        rules::can_hu(&drawn, &kong, missing),
+        "the drawn shape pairs 5T and completes three W sets"
+    );
+    assert_eq!(
+        evaluator.deficit(&drawn),
+        2,
+        "the kong owns every 5T copy, so the 5T pair is not a legal target"
+    );
+}
