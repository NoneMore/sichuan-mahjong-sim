+#[test]
+fn declared_melds_match_the_direct_win_shortcut() {
+    let missing = Suit::Tiao;
+
+    // m = 1 standard tenpai on 9W for every one-meld shape of the 5T meld.
+    let ready = suit_hand(&[1, 2, 3, 4, 5, 6, 7, 8, 9, 9], &[], &[]);
+    let meld_shapes = [
+        (
+            "exposed peng",
+            Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+        ),
+        (
+            "added kong",
+            Meld::added_kong(tile(Suit::Tong, 5), Seat::DEALER),
+        ),
+        (
+            "open kong",
+            Meld::open_kong(tile(Suit::Tong, 5), Seat::DEALER),
+        ),
+    ];
+    for (label, meld) in meld_shapes {
+        let melds = [meld];
+        let public = own_meld_public(&melds);
+        assert!(
+            assert_candidate_matches_original(label, &ready, &melds, missing, &public) > 0,
+            "{label}: 9W completes 123456789W + 99W"
+        );
+    }
+
+    // m = 1 concealed kong: the kong owns all four 3W copies, so the 3W
+    // sequence wait is not a legal target and the hand is not tenpai.
+    let kong = [Meld::concealed_kong(tile(Suit::Wan, 3))];
+    let capped = suit_hand(&[1, 2, 4, 5, 6, 7, 8, 9, 9, 9], &[], &[]);
+    let public = own_meld_public(&kong);
+    let mut evaluator = DistanceEvaluator::new(&kong, missing).expect("legal meld count");
+    assert!(
+        evaluator.deficit(&capped) > 1,
+        "the concealed kong must remove 3W as a legal completion"
+    );
+    assert!(
+        !eval::waiting_tiles(&capped, &kong).contains(&tile(Suit::Wan, 3)),
+        "waiting_tiles already drops meld-exhausted copies"
+    );
+    assert_candidate_matches_original(
+        "concealed kong exhaustion",
+        &capped,
+        &kong,
+        missing,
+        &public,
+    );
+}
