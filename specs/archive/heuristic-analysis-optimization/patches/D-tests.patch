+#[test]
+fn four_meld_hands_match_the_direct_win_shortcut() {
+    let missing = Suit::Tiao;
+    let melds = [
+        Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+        Meld::open_kong(tile(Suit::Tong, 6), Seat::DEALER),
+        Meld::concealed_kong(tile(Suit::Tong, 7)),
+        Meld::added_kong(tile(Suit::Tong, 8), Seat::DEALER),
+    ];
+    let single = suit_hand(&[9], &[], &[]);
+    let public = own_meld_public(&melds);
+    assert_eq!(
+        assert_candidate_matches_original(
+            "four melds pair wait",
+            &single,
+            &melds,
+            missing,
+            &public
+        ),
+        3,
+        "the 9W pair wait has three unseen copies"
+    );
+
+    // Public exhaustion keeps the structural wait but removes all copies.
+    let mut exhausted = public;
+    add_public(&mut exhausted, tile(Suit::Wan, 9), 3);
+    let mut evaluator = DistanceEvaluator::new(&melds, missing).expect("legal meld count");
+    assert_eq!(
+        evaluator.deficit(&single),
+        1,
+        "the pair wait survives public exhaustion"
+    );
+    assert_eq!(
+        assert_candidate_matches_original(
+            "four melds public exhaustion",
+            &single,
+            &melds,
+            missing,
+            &exhausted
+        ),
+        0,
+        "a fully public wait contributes no ukeire"
+    );
+
+    // Own meld exhaustion: the peng owns three 9W copies, so a 9W pair would
+    // need a fifth copy and is not a legal target.
+    let owns_nine = [
+        Meld::peng(tile(Suit::Wan, 9), Seat::DEALER),
+        Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+        Meld::peng(tile(Suit::Tong, 6), Seat::DEALER),
+        Meld::peng(tile(Suit::Tong, 7), Seat::DEALER),
+    ];
+    let public = own_meld_public(&owns_nine);
+    let mut evaluator = DistanceEvaluator::new(&owns_nine, missing).expect("legal meld count");
+    assert!(
+        evaluator.deficit(&single) > 1,
+        "the player's own peng exhausts the only pair target"
+    );
+    assert_candidate_matches_original(
+        "four melds own peng exhaustion",
+        &single,
+        &owns_nine,
+        missing,
+        &public,
+    );
+}
