+
+    // m = 2 non-tenpai: three pairs and a singleton cannot become two sets and
+    // a pair with a single draw.
+    let pairs_only = suit_hand(&[1, 1, 4, 4, 7, 7, 9], &[], &[]);
+    assert_candidate_matches_original("two melds pairs only", &pairs_only, &two, missing, &public);
+
+    // m = 3 with an added kong: 1122W waits on 1W and on 2W.
+    let three = [
+        Meld::peng(tile(Suit::Tong, 5), Seat::DEALER),
+        Meld::peng(tile(Suit::Tong, 6), Seat::DEALER),
+        Meld::added_kong(tile(Suit::Tong, 7), Seat::DEALER),
+    ];
+    let public = own_meld_public(&three);
+    let pair_waits = suit_hand(&[1, 1, 2, 2], &[], &[]);
+    assert_eq!(
+        assert_candidate_matches_original(
+            "three melds double wait",
+            &pair_waits,
+            &three,
+            missing,
+            &public
+        ),
+        4,
+        "1W x2 and 2W x2 remain unseen"
+    );
+
+    // m = 3 non-tenpai: one set plus a pair is still three draws away.
+    let scattered = suit_hand(&[1, 4, 7, 9], &[], &[]);
+    assert_candidate_matches_original(
+        "three melds scattered",
+        &scattered,
+        &three,
+        missing,
+        &public,
+    );
+}
