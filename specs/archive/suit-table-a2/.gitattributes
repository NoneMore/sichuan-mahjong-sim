# Keep portable scripts and unified patches LF so their bytes and hashes stay
# verifiable across checkout; a unified diff intentionally contains
# space-prefixed empty context lines, so patch whitespace checks are exempt.
.gitattributes text eol=lf
*.py text eol=lf
patches/*.patch text eol=lf -whitespace

# Raw measurement records and the asm reports are readable text checked in LF.
measurements/*.json text eol=lf
measurements/asm/* text eol=lf
# Assembly unified diffs retain space-prefixed context lines before tab-indented
# instructions; like source patches, their whitespace is part of the evidence.
measurements/asm/diff-*.txt -whitespace
